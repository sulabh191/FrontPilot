{
  "name": "frontpilot",
  "private": true,
  "packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:psql": "docker exec -it frontpilot-postgres psql -U frontpilot -d frontpilot",
    "db:generate": "pnpm --filter @frontpilot/db generate",
    "db:migrate": "pnpm --filter @frontpilot/db migrate",
    "db:studio": "pnpm --filter @frontpilot/db studio",
    "db:seed": "pnpm --filter @frontpilot/db seed",
    "api:generate": "pnpm --filter @frontpilot/api openapi:export && pnpm --filter @frontpilot/api-client generate",
    "test": "turbo run test"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "latest"
  }
}
