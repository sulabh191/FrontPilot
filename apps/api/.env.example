# Copy to .env.local (ignored by Git) and fill in.
PORT=4000
DATABASE_URL=postgres://frontpilot:frontpilot@localhost:5433/frontpilot
# Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:3000
# Development login (any random string of 16+ characters). Generate one with: openssl rand -hex 24
DEV_AUTH_TOKEN=
DEV_TENANT_SLUG=rapid-plumbing
