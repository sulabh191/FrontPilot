# Copy this file to .env.local and fill in real values.
# .env.local is ignored by Git and must never be committed.

# FrontPilot API (apps/api). Server-only: never prefix these with NEXT_PUBLIC_.
API_URL=http://localhost:4000
# Same value as DEV_AUTH_TOKEN in apps/api/.env.local
API_TOKEN=
# Public: the browser's chat widget calls the API at this address. Never put a secret in a NEXT_PUBLIC_ setting.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Anthropic API key, from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: model for the chat agent (default: claude-haiku-4-5-20251001)
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Postgres (local Docker database from docker-compose.yml)
DATABASE_URL=postgres://frontpilot:frontpilot@localhost:5433/frontpilot

# SMS notifications: "console" prints texts in the terminal (default), "twilio" sends real SMS
SMS_PROVIDER=console
# Only needed when SMS_PROVIDER=twilio (from https://console.twilio.com)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+1XXXXXXXXXX
